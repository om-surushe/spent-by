{
  "name": "spent-by",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4174",
    "build": "tsc --noEmit && vite build",
    "test": "node --test --experimental-strip-types src/lib/money.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "standards:check": "node scripts/check-standards.mjs",
    "worker:dev": "wrangler dev --local --port 8787",
    "worker:types": "wrangler types --env preview",
    "worker:check": "tsc --noEmit -p tsconfig.worker.json",
    "worker:deploy:preview": "wrangler deploy --env preview --strict",
    "worker:deploy:production": "wrangler deploy --env production --strict",
    "check:responsive": "node scripts/check-responsive-css.mjs",
    "check:responsive:browser": "node scripts/responsive-browser-qa.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.63.0",
    "storybook": "10.6.0",
    "typescript": "^5.6.2",
    "vite": "^8.3.3",
    "wrangler": "^4.145.0"
  }
}

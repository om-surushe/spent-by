{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "finance-vault-worker-local",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health"]
  },
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.1 } },
  "vars": { "ENVIRONMENT": "local", "ALLOW_VAULT_CREATE": "1", "CORS_ORIGIN": "http://localhost:4174", "MAX_REQUEST_BYTES": "1048576", "MAX_VAULT_BYTES": "1048576" },
  "d1_databases": [{ "binding": "DB", "database_name": "finance-vault-preview", "database_id": "f87ef6ee-edaa-4db5-9a28-aa5b54c36eed", "migrations_dir": "migrations" }],
  "env": {
    "preview": {
      "name": "finance-vault-worker-preview",
      "vars": { "ENVIRONMENT": "preview", "ALLOW_VAULT_CREATE": "1", "CORS_ORIGIN": "https://finance-vault-worker-preview.omsurushe1907.workers.dev", "MAX_REQUEST_BYTES": "1048576", "MAX_VAULT_BYTES": "1048576" },
      "d1_databases": [{ "binding": "DB", "database_name": "finance-vault-preview", "database_id": "f87ef6ee-edaa-4db5-9a28-aa5b54c36eed", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "IP_LIMITER", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "VAULT_LIMITER", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
      ]
    },
    "production": {
      "name": "finance-vault-worker",
      "vars": { "ENVIRONMENT": "production", "ALLOW_VAULT_CREATE": "0", "CORS_ORIGIN": "https://finance.usechapter.club", "MAX_REQUEST_BYTES": "1048576", "MAX_VAULT_BYTES": "1048576" },
      "d1_databases": [{ "binding": "DB", "database_name": "finance-vault", "database_id": "eb05e322-7c05-4861-8780-2eb849e59b2b", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "IP_LIMITER", "namespace_id": "2101", "simple": { "limit": 30, "period": 60 } },
        { "name": "VAULT_LIMITER", "namespace_id": "2102", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
}
